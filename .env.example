APP_NAME=PRAGATI
APP_ENV=development
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"   (>= 32 chars, different values)
SECRET_KEY=
REFRESH_SECRET_KEY=
DATABASE_URL=sqlite+aiosqlite:///./pragati.db
# postgres example: postgresql+asyncpg://pragati:CHANGE_ME@postgres:5432/pragati
REDIS_URL=
MODEL_PATH=./models
VECTOR_DB_PATH=./data/processed/doc_index
UPLOAD_DIR=./data/uploads
REPORT_DIR=./data/reports
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
# Optional JSON override of risk weights, e.g. {"schedule":25,"cost":20,"progress":25,"milestone":15,"trend":10,"data_quality":5,"issues":0}
RISK_WEIGHTS_JSON=
POSTGRES_PASSWORD=
